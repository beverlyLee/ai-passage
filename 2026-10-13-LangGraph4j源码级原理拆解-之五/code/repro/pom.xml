<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>langgraph4j-demo5</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.bsc</groupId>
            <artifactId>langgraph4j-core</artifactId>
            <version>1.5.14</version>
        </dependency>
        <!-- langgraph4j-core 传递依赖，这里显式声明以便直接引用 AsyncGenerator 的遍历接口 -->
        <dependency>
            <groupId>org.bsc.async</groupId>
            <artifactId>async-generator</artifactId>
            <version>3.2.0</version>
        </dependency>
        <!-- langgraph4j-core 把 slf4j-api 声明为 compile 依赖但未锁定版本，显式给出一个稳定版本，保证运行时日志门面可取 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>
        <!-- 说明：FileSystemSaver 落盘走 CheckPointSerializer + ObjectStreamStateSerializer，
             Java 原生序列化，不需要 gson/jackson；本例不引入它们 -->
    </dependencies>
</project>
